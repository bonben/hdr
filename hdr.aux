\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces In the case of non-structured magnitude pruning, SWD behaves as such: all weights $w$ of $\mathbf  {W}$ are applied a penalty $P$, that combines weight decay and SWD. Since SWD is only applied to weights below a given threshold $t$, it is like $P$ applies a stronger penalty on weights below $t$ and a smaller one above $t$. Another way to present this is to consider SWD as a trap that progressively subjects weights below a certain threshold to an increasingly strong penalty, that drives them to zero, thus pruning them.}}{42}{figure.caption.71}\protected@file@percent }
\newlabel{fig:swd_illustration}{{3.4}{42}{In the case of non-structured magnitude pruning, SWD behaves as such: all weights $w$ of $\mathbf {W}$ are applied a penalty $P$, that combines weight decay and SWD. Since SWD is only applied to weights below a given threshold $t$, it is like $P$ applies a stronger penalty on weights below $t$ and a smaller one above $t$. Another way to present this is to consider SWD as a trap that progressively subjects weights below a certain threshold to an increasingly strong penalty, that drives them to zero, thus pruning them}{figure.caption.71}{}}
\newlabel{eq:a_definition}{{3.6}{42}{Selective Weight Decay (SWD)}{equation.3.2.6}{}}
